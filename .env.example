# =====================================================================
# WIMALI EMPRENDIMIENTOS — variables de entorno (ejemplo)
# Copiá este archivo como .env.local y completá con tus valores.
# NUNCA subas .env.local al repositorio (está en .gitignore).
# =====================================================================

# URL de tu instancia de Supabase (self-hosted o cloud).
NEXT_PUBLIC_SUPABASE_URL=https://api.neura.com.py

# Clave anónima (pública, segura para el navegador).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Schema propio del proyecto (todas las tablas viven acá).
NEXT_PUBLIC_SUPABASE_SCHEMA=wimaliemprendimientos

# ---------------------------------------------------------------------
# NO agregar la SERVICE_ROLE_KEY acá ni en ningún archivo del frontend.
# Esa clave saltea RLS y solo debe usarse en entornos de servidor de
# confianza (nunca en el navegador ni en el repositorio).
# ---------------------------------------------------------------------
